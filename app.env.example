# ============================================================
# hit-switchbot-webui 環境変数設定サンプル
# 使い方: このファイルを .env としてコピーし、値を設定してください
#   cp .env.example .env
# ============================================================

# SwitchBotアプリの「プロフィール → 設定 → アプリバージョンを連続タップ
# → 開発者向けオプション」から発行したtoken/secret
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# JWT署名に使う秘密鍵。生成コマンド:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# ログインユーザー名
ADMIN_USERNAME=admin

# ログインパスワードのbcryptハッシュ(平文は保存しない)。生成コマンド:
#   python3 -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('好きなパスワード'))"
ADMIN_PASSWORD_HASH=

# JWTトークンの有効期限(時間)。外部公開のため短めを推奨。
JWT_EXPIRE_HOURS=24

# WebUI/APIの待受ポート
APP_PORT=8092
