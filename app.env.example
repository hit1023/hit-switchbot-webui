# ============================================================
# hit-switchbot-webui 環境変数設定サンプル
# 使い方: このファイルを app.env としてコピーし、値を設定してください
#   cp app.env.example app.env
# ============================================================

# SwitchBotアプリの「プロフィール → 設定 → アプリバージョンを連続タップ
# → 開発者向けオプション」から発行したtoken/secret
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# JWT署名に使う秘密鍵。生成コマンド:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# ログインユーザー名
ADMIN_USERNAME=admin

# ログインパスワードのbcryptハッシュ(平文は保存しない)。生成コマンド:
#   python3 -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('好きなパスワード'))"
ADMIN_PASSWORD_HASH=

# JWTトークンの有効期限(時間)。外部公開のため短めを推奨。
JWT_EXPIRE_HOURS=24

# WebUI/APIの待受ポート
APP_PORT=8092

# 鍵の物理的な施錠/解錠(アプリ/指紋/キーパッド等、経路を問わない)を
# リアルタイムにログへ記録するためのWebhook設定。
# 外部からHTTPSでアクセスできるこのアプリの公開URL(末尾の/なし)
PUBLIC_BASE_URL=https://your-domain.example.com

# Webhook受信URLに含めるランダムトークン(第三者がURLを推測できないように)。生成コマンド:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
WEBHOOK_PATH_TOKEN=
